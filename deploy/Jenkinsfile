// Pipeline: juice-shop-deploy
// Purpose:  Deploy Juice Shop to the existing EKS cluster via kubectl.
// Jenkins job config: Pipeline script from SCM -> Script Path: deploy/Jenkinsfile

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 20, unit: 'MINUTES')
  }

  parameters {
    string(name: 'CLUSTER_NAME', defaultValue: 'juice-shop-cluster', description: 'EKS cluster name')
    string(name: 'REGION',       defaultValue: 'us-east-2',          description: 'AWS region')
    string(name: 'NAMESPACE',    defaultValue: 'juice-shop',         description: 'Kubernetes namespace')
  }

  environment {
    AWS_DEFAULT_REGION = "${params.REGION}"
    KUBECONFIG         = "${WORKSPACE}/.kube/config"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Tool versions') {
      steps {
        sh 'aws --version && kubectl version --client=true && aws sts get-caller-identity'
      }
    }

    stage('Connect to EKS') {
      steps {
        sh 'mkdir -p "$(dirname \"$KUBECONFIG\")"'
        sh 'aws eks update-kubeconfig --name "${CLUSTER_NAME}" --region "${AWS_DEFAULT_REGION}" --kubeconfig "$KUBECONFIG"'
        sh 'kubectl cluster-info'
        sh 'kubectl get nodes -o wide'
      }
    }

    stage('Apply Manifests') {
      steps {
        sh 'kubectl apply -f deploy/k8s/namespace.yaml'
        sh 'kubectl apply -f deploy/k8s/deployment.yaml'
        sh 'kubectl apply -f deploy/k8s/service.yaml'
      }
    }

    stage('Wait for rollout') {
      steps {
        sh 'kubectl -n "${NAMESPACE}" rollout status deployment/juice-shop --timeout=5m'
        sh 'kubectl -n "${NAMESPACE}" get pods -o wide'
      }
    }

    stage('Show service endpoint') {
      steps {
        sh """
          sleep 60
          kubectl -n \"\${NAMESPACE}\" get svc juice-shop
          URL=\$(kubectl -n \"\${NAMESPACE}\" get svc juice-shop -o jsonpath="{.status.loadBalancer.ingress[0].hostname}")
          echo ""
          echo "============================================================"
          echo "  JUICE SHOP IS LIVE:"
          echo "  http://\${URL}"
          echo "============================================================"
        """
      }
    }
  }

  post {
    success { echo "Juice Shop deployment successful." }
    failure { echo "Deployment FAILED. Check stages above." }
  }
}
