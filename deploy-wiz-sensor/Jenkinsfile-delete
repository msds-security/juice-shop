// Pipeline: juice-shop-delete-wiz-sensor
// Purpose:  Uninstall the Wiz Runtime Sensor from juice-shop-cluster.
//           Leaves the cluster and app running - only removes the sensor.

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 10, unit: 'MINUTES')
  }

  parameters {
    string(name: 'CLUSTER_NAME',  defaultValue: 'juice-shop-cluster', description: 'EKS cluster name')
    string(name: 'REGION',        defaultValue: 'us-east-2',          description: 'AWS region')
    string(name: 'WIZ_NAMESPACE', defaultValue: 'wiz',                description: 'K8s namespace with the sensor')
    booleanParam(name: 'DELETE_NAMESPACE', defaultValue: true, description: 'Also delete the wiz namespace')
  }

  environment {
    AWS_DEFAULT_REGION = "${params.REGION}"
    KUBECONFIG         = "${WORKSPACE}/.kube/config"
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Tool versions') {
      steps {
        sh 'aws --version && kubectl version --client=true && helm version --short'
      }
    }

    stage('Connect to EKS') {
      steps {
        sh 'mkdir -p "$(dirname \"$KUBECONFIG\")"'
        sh 'aws eks update-kubeconfig --name "${CLUSTER_NAME}" --region "${AWS_DEFAULT_REGION}" --kubeconfig "$KUBECONFIG"'
        sh 'kubectl cluster-info'
      }
    }

    stage('Show what will be deleted') {
      steps {
        sh '''
          echo "--- Helm releases in $WIZ_NAMESPACE ---"
          helm -n "$WIZ_NAMESPACE" list || true
          echo ""
          echo "--- Sensor pods ---"
          kubectl -n "$WIZ_NAMESPACE" get pods -l app.kubernetes.io/name=wiz-sensor || true
        '''
      }
    }

    stage('Uninstall Wiz Runtime Sensor') {
      steps {
        sh '''
          if helm -n "$WIZ_NAMESPACE" list -q | grep -q "^wiz-sensor$"; then
            echo "Uninstalling wiz-sensor helm release..."
            helm -n "$WIZ_NAMESPACE" uninstall wiz-sensor --wait || true
          else
            echo "wiz-sensor helm release not present - skipping"
          fi
        '''
      }
    }

    stage('Delete namespace (optional)') {
      when { expression { return params.DELETE_NAMESPACE } }
      steps {
        sh 'chmod +x deploy-wiz-sensor/scripts/delete-namespace.sh && deploy-wiz-sensor/scripts/delete-namespace.sh "$WIZ_NAMESPACE"'
      }
    }

    stage('Verify teardown') {
      steps {
        sh '''
          echo "--- Remaining pods in $WIZ_NAMESPACE ---"
          kubectl -n "$WIZ_NAMESPACE" get pods 2>&1 || echo "Namespace is gone."
        '''
      }
    }
  }

  post {
    success { echo "Wiz sensor removed. Cluster and app still running." }
    failure { echo "Delete FAILED. Check stages above." }
  }
}
