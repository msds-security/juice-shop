// Pipeline: juice-shop-deploy-wiz
// Purpose:  Deploy Juice Shop with Wiz CLI scans (IaC + image) BEFORE deploy.
//           Runs in a separate namespace (juice-shop-wiz) so it coexists
//           with the baseline juice-shop deployment.
// Jenkins job config: Pipeline script from SCM -> Script Path: deploy-wiz/Jenkinsfile

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 25, unit: 'MINUTES')
  }

  parameters {
    string(name: 'CLUSTER_NAME', defaultValue: 'juice-shop-cluster', description: 'EKS cluster name')
    string(name: 'REGION',       defaultValue: 'us-east-2',          description: 'AWS region')
    string(name: 'NAMESPACE',    defaultValue: 'juice-shop-wiz',     description: 'Kubernetes namespace')
    string(name: 'IMAGE',        defaultValue: 'bkimminich/juice-shop:latest', description: 'Container image to scan/deploy')
  }

  environment {
    AWS_DEFAULT_REGION = "${params.REGION}"
    KUBECONFIG         = "${WORKSPACE}/.kube/config"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Tool versions') {
      steps {
        sh 'aws --version && kubectl version --client=true && aws sts get-caller-identity'
      }
    }

    stage('Connect to EKS') {
      steps {
        sh 'mkdir -p "$(dirname \"$KUBECONFIG\")"'
        sh 'aws eks update-kubeconfig --name "${CLUSTER_NAME}" --region "${AWS_DEFAULT_REGION}" --kubeconfig "$KUBECONFIG"'
        sh 'kubectl cluster-info'
      }
    }

    stage('Wiz: Scan IaC manifests') {
      steps {
        echo '============================================================'
        echo '  WIZ: Scanning Kubernetes manifests (IaC)'
        echo '============================================================'
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
          wizcli userInput: 'iac scan --path deploy-wiz/k8s --name juice-shop-wiz-iac'
        }
      }
    }

    stage('Wiz: Scan container image') {
      steps {
        echo '============================================================'
        echo '  WIZ: Scanning container image'
        echo "  Image: ${params.IMAGE}"
        echo '============================================================'
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
          wizcli userInput: "docker scan --image ${params.IMAGE} --name juice-shop-wiz-image"
        }
      }
    }

    stage('Apply Manifests') {
      steps {
        sh 'kubectl apply -f deploy-wiz/k8s/namespace.yaml'
        sh 'kubectl apply -f deploy-wiz/k8s/deployment.yaml'
        sh 'kubectl apply -f deploy-wiz/k8s/service.yaml'
      }
    }

    stage('Wait for rollout') {
      steps {
        sh 'kubectl -n "${NAMESPACE}" rollout status deployment/juice-shop --timeout=5m'
        sh 'kubectl -n "${NAMESPACE}" get pods -o wide'
      }
    }

    stage('Show service endpoint') {
      steps {
        sh """
          sleep 60
          kubectl -n \"\${NAMESPACE}\" get svc juice-shop
          URL=\$(kubectl -n \"\${NAMESPACE}\" get svc juice-shop -o jsonpath="{.status.loadBalancer.ingress[0].hostname}")
          echo ""
          echo "============================================================"
          echo "  JUICE SHOP (WIZ-SCANNED) IS LIVE:"
          echo "  http://\${URL}"
          echo "============================================================"
        """
      }
    }
  }

  post {
    success  { echo "Juice Shop (Wiz-scanned) deployment successful." }
    unstable { echo "Deployment succeeded but Wiz scans found issues. Review the Wiz-scanned stages above or check the Wiz console." }
    failure  { echo "Pipeline FAILED. Check stages above." }
  }
}
